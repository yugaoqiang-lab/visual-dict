<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 【关键修复】Android 11+(API30+) 包可见性：不声明 <queries> 时 getEngines() 会返回空，
         即使设备已安装 TTS 引擎（如 eSpeak/RHVoice），App 也“看不见”，导致 0 引擎、发音失败。
         这里显式声明 TTS 服务 intent + 常见引擎包名，让本 App 能发现并绑定它们。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <package android:name="com.reecedunn.espeak" />
        <package android:name="com.github.olga_yakovleva.rhvoice.android" />
        <package android:name="edu.cmu.cs.speech.flite" />
        <package android:name="com.google.android.tts" />
        <package android:name="com.iflytek.speechcloud" />
        <package android:name="com.iflytek.tts" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NoActionBar"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
